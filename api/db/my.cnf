[client]
# O servidor usa os certificados autoassinados que o MySQL gera na instalação
# (CN=MySQL_Server_8.0.33_Auto_Generated_Server_Certificate), que o Windows não
# reconhece. A conexão continua criptografada; apenas a verificação da
# identidade do servidor é dispensada.
#
# Esta opção vive aqui, e não em Mysql2::Client.new, porque a gem mysql2 está
# ligada ao MariaDB Connector/C 3.4.8 e ignora :ssl_mode quando a versão do
# cliente é < 50703. O connector, por outro lado, honra este arquivo.
ssl-verify-server-cert=0
